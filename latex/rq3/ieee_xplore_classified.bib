@INPROCEEDINGS{11368431,
  author={Shaikh, Vasim and Walunj, Vijay and Hanumantharaya, Amarnath and Vanama, Harsha},
  booktitle={2025 4th International Conference on Computing, Management and Telecommunications (ComManTel)}, 
  title={Automated Test Case Generation (ATCG): Leveraging Large Language Models for Software Testing}, 
  year={2025},
  volume={},
  number={},
  pages={170-178},
  abstract={Software quality assurance (SQA) processes require automated test case generation as a fundamental component to ensure both software reliability and efficiency. Manual testing approaches are increasingly being replaced by automated testing strategies due to their susceptibility to human error and significant time requirements. Recent advances in artificial intelligence technologies, particularly large language models (LLMs), present an opportunity to revolutionize software testing automation methods. This paper introduces a novel SQA test case generation methodology based on GPT and other advanced LLMs. The proposed approach automatically converts the source code, the requirements documentation, and other software artifacts into appropriate testing scenarios. We conduct an experimental evaluation by comparing our approach with conventional test case generation techniques. Our results demonstrate that LLM- based test case generation significantly improves both coverage and precision during testing processes, with an average code coverage of 85% compared to 60% for traditional methods. LLMs effectively address common testing challenges by enhancing error detection capabilities, making them suitable for modern software testing processes. Future work will focus on extending the model to handle more complex test case scenarios in real- world implementations. Index Terms-Index Terms - Test Case Generation, Software Quality Assurance, Large Language Models, Automation, AI, Software Testing},
  keywords={Software testing;Automation;Large language models;Source coding;Software quality;Manuals;Documentation;Telecommunications;Software reliability;Indexes},

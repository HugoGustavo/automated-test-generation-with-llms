  keywords={Costs;Systematics;Statistical analysis;Navigation;Source coding;Maintenance engineering;Packaging;automated test input generation;testing;refinement;Large Language Models},
  doi={10.1109/SANER60148.2024.00041},
  ISSN={2640-7574},
  month={March}
}


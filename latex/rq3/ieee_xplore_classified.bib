}

@INPROCEEDINGS{10962997,
  author={Godage, Tharindu and Nimishan, Sivaraj and Vasanthapriyan, Shanmuganathan and Palanisamy, Vigneshwaran and Joseph, Charles and Thuseethan, Selvarajah},
  booktitle={2025 5th International Conference on Advanced Research in Computing (ICARC)}, 
  title={Evaluating the Effectiveness of Large Language Models in Automated Unit Test Generation}, 
  year={2025},

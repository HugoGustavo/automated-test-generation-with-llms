  author={Mani, Nariman and Attaranasl, Salma},
  booktitle={2025 IEEE International Conference on Software Testing, Verification and Validation Workshops (ICSTW)}, 
  title={Adaptive Test Healing using LLM/GPT and Reinforcement Learning}, 
  year={2025},

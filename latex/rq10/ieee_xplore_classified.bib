@INPROCEEDINGS{11127254,
  author={Mani, Nariman and Attaranasl, Salma},
  booktitle={2025 IEEE International Conference on Artificial Intelligence Testing (AITest)}, 
  title={Enhancing Adaptive Test Healing with Graph Neural Networks for Dependency-Aware Decision Making}, 
  year={2025},
  volume={},
  number={},
  pages={126-133},
  abstract={Flaky tests are a major obstacle in modern CI/CD pipelines, leading to unreliable feedback, increased reruns, and developer frustration. Our previously published adaptive healing framework combined Large Language Models (LLMs) and Reinforcement Learning (RL) to automate flaky test recovery, but it assumed test independence and failed to account for structural dependencies between tests. In this paper, we introduce a significant extension to that baseline: a Graph Neural Network (GNN)-based Test Dependency Mapping layer that models intertest relationships. By integrating GNN embeddings with LLM-classified failures, the RL agent becomes dependency-aware, enabling more precise and efficient healing decisions. We evaluate the enhanced framework on a real-world industrial platform, a social lifestyle application actively used by thousands of users for health, nutrition, and coaching. Results show a 90% reduction in flaky test-related costs and faster, autonomous resolution of dependency-induced failures.},
  keywords={Adaptive systems;Costs;Large language models;Decision making;Pipelines;Reinforcement learning;Transformers;Graph neural networks;Real-time systems;Testing;Adaptive Test Healing;Large Language Models (LLMs);GPT;Reinforcement Learning (RL);Flaky Tests;Self-Healing Test Automation;Continuous Integration (CI);Graph Neural Networks (GNN)},
  doi={10.1109/AITest66680.2025.00023},
  ISSN={2835-3560},
  month={July}
}

@INPROCEEDINGS{11436286,

@ARTICLE{11411685,
  author={Sisomboon, Wantana and Kaewyotha, Jakkrit and Songpan, Wararat},
  journal={IEEE Access}, 
  title={Automated Software Test Case Generation Using Directional Partially Weighted Ensemble Large Language Models With Retrieval-Augmented Generation (RAG)}, 
  year={2026},
  volume={14},
  number={},
  pages={31124-31145},
  abstract={Ensuring software quality relies on testing practices that can reliably confirm whether delivered systems meet user requirements. While Acceptance Test-Driven Development (ATDD) encourages early collaboration between stakeholders and developers, creating comprehensive acceptance test cases remains a human task that heavily depends on domain expertise. Recent progress in Large Language Models (LLMs) has made automated test case generation feasible. However, approaches based on a single model often suffer from performance instability, uneven test coverage, and a limited ability to generalize across heterogeneous requirements. This study proposes an automated test case generation framework that combines directional partially weighted ensemble large language models (LLMs) with Retrieval-Augmented Generation (RAG). The framework assigns model influence dynamically according to directional performance trends and degrees of partial correctness and consolidates candidate outputs through a weighted majority-voting mechanism and cross-validation conducted over multiple folds. Five state-of-the-art LLMs, Claude, ChatGPT, Gemini, Qwen, and Mistral, were evaluated using 16 criteria derived from four widely adopted closed box testing techniques: Boundary Value Analysis, Equivalence Partitioning, Use Case testing, and State Transition testing. Under the evaluated experimental conditions, the proposed framework achieved 98.44% test coverage, indicating complete consistency with the defined gold-standard acceptance criteria. Cross-validation results further demonstrate improved robustness, stronger generalization to previously unseen requirements, and linear scalability, supporting practical deployment in real-world software development environments, and complexity analysis to confirm linear throughout growth (O(n)), which supports efficient deployment under increasing workloads.},
  keywords={Testing;Retrieval augmented generation;Software testing;Large language models;Closed box;Test pattern generators;Collaboration;Chatbots;Stakeholders;Software reliability;LLM;RAG;weighted ensemble;directional partially;test coverage;ATDD;automated software testing},
  doi={10.1109/ACCESS.2026.3667925},
  ISSN={2169-3536},
  month={}
}

@INPROCEEDINGS{10589904,
  author={Karmarkar, Hrishikesh and Agrawal, Supriya and Chauhan, Avriti and Shete, Pranav},
  booktitle={2024 IEEE International Conference on Software Analysis, Evolution and Reengineering (SANER)}, 
  title={Navigating Confidentiality in Test Automation: A Case Study in LLM Driven Test Data Generation}, 
  year={2024},
  volume={},
  number={},
  pages={337-348},
  abstract={In out sourced industrial projects for testing of web applications, often neither the application to be tested, nor its source code are provided to the testing team, due to confidentiality reasons, making systematic testing of these applications very challenging. However, textual descriptions of such systems are often available. So, one can consider leveraging a Large Language Model (LLM) to parse these descriptions and synthesize test generators (programs that produce test data). In our experience, LLM synthesized test generators suffer from two problems:- (1) unsound: the generators might produce invalid data and (2) incomplete: the generators typically fail to generate all expected valid inputs. To mitigate these problems, we introduce TestRefineGen a method for autonomously generating test data from textual descriptions. TestRe-fineGen begins by invoking an LLM to parse a given corpus of documents and produce multiple test gener-ators. It then uses a novel ranking approach to identify generators that can produce invalid test data, and then automatically repairs them using a counterexample-guided refinement process. Lastly, TestRefineGen per-forms a generalization procedure that offsets synthesis or refinements that leads to incompleteness, to obtain generators that produce more comprehensive valid in-puts. We evaluated the effectiveness of TestRefineGen on a manually curated set of 256 textual descriptions of test data. TestRefineGen synthesized generators that produce valid test data for 66.01 % of the descriptions. Using a combination of post-processing sanitisation and refinement it was able to successfully repair synthesized generators, which improved the success rate to 76.95 %. Further, our statistical analysis on a small subset of synthesized generators shows that TestRefineGen is able to generate test data that is well distributed across the input space. Thus, TestRefineGen can be an effective technique for autonomous test data generation for web testing in projects with confidentiality concerns.},
  keywords={Costs;Systematics;Statistical analysis;Navigation;Source coding;Maintenance engineering;Packaging;automated test input generation;testing;refinement;Large Language Models},
  doi={10.1109/SANER60148.2024.00041},
  ISSN={2640-7574},
  month={March}
}

@INPROCEEDINGS{11081451,
  author={Ferreira, Margarida and Viegas, Luís and Faria, João Pascoal and Lima, Bruno},
  booktitle={2025 IEEE/ACM International Conference on Automation of Software Test (AST)}, 
  title={Acceptance Test Generation with Large Language Models: An Industrial Case Study}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={Large language model (LLM)-powered assistants are increasingly used for generating program code and unit tests, but their application in acceptance testing remains underexplored. To help address this gap, this paper explores the use of LLMs for generating executable acceptance tests for web applications through a two-step process: (i) generating acceptance test scenarios in natural language (in Gherkin) from user stories, and (ii) converting these scenarios into executable test scripts (in Cypress), knowing the HTML code of the pages under test. This two-step approach supports acceptance test-driven development, enhances tester control, and improves test quality. The two steps were implemented in the AutoUAT and Test Flow tools, respectively, powered by GPT-4 Turbo, and integrated into a partner company’s workflow and evaluated on real-world projects. The users found the acceptance test scenarios generated by AutoUAT helpful 95% of the time, even revealing previously overlooked cases. Regarding Test Flow, 92% of the acceptance test cases generated by Test Flow were considered helpful: 60% were usable as generated, 8% required minor fixes, and 24% needed to be regenerated with additional inputs; the remaining 8% were discarded due to major issues. These results suggest that LLMs can, in fact, help improve the acceptance test process, with appropriate tooling and supervision.},
  keywords={Costs;Codes;Automation;Accuracy;Large language models;Natural languages;Software;Test pattern generators;Usability;Testing;Acceptance Testing;Large Language Models;Automatic Test Generation;Web Application Testing},
  doi={10.1109/AST66626.2025.00007},
  ISSN={2833-9061},
  month={April}
}

@INPROCEEDINGS{11395666,
  author={Mavani, Vatsal Kishorbhai},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Codebase Aware Generative Agents for the SDLC: Automating Documentation, Dependency Analysis and Test Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={Autonomous agents are becoming common in software development, but they often struggle to maintain context in large, changing codebases. To solve this, we propose CA-SAF (Codebase-Aware Self-Adapting Framework), a multi-agent system designed to fix this architectural "blindness" by actively retrieving precise code details. Our core innovation is ZSDM (Zero-Shot Dependency Mapping). This hybrid method combines AST parsing with strict LLM extraction to map every entity and relationship into a queryable Knowledge Graph. By using structured code summaries, we achieved roughly 80% data compression, ensuring the context remains efficient. We benchmarked the system against GPT-4o, LLaMA 3.1, and Claude 3 Opus. We found that Claude 3 Opus, with its 200,000 - token window, slightly outperformed the others (capped at 128,000) on complex, non-local mapping tasks. Over a six-month operational study, using CA-SAF led to a measurable drop in both Cycle Time and Lead Time for maintenance work. Crucially, the framework used this codebase awareness to balance speed with quality, actively reducing the number of critical bugs that high-speed LLM generation often introduces.},
  keywords={Codes;Knowledge graphs;Autonomous agents;Time measurement;Windows;Maintenance;Complexity theory;Test pattern generators;Software development management;Multi-agent systems;Generative AI;Autonomous Agents;Software Development Life Cycle (SDLC);Knowledge Graph;Retrieval-Augmented Generation (RAG);Zero-Shot Dependency Mapping;Technical Debt},
  doi={10.1109/ICAIC67076.2026.11395666},
  ISSN={},
  month={Feb}
}

@INPROCEEDINGS{11190124,
  author={Magalhaes, Cleyton and Santos, Italo and Stuart-Verner, Brody and De Souza Santos, Ronnie},
  booktitle={2025 IEEE International Conference on Source Code Analysis & Manipulation (SCAM)}, 
  title={Testing the Untestable? An Empirical Study on the Testing Process of LLM-Powered Software Systems}, 
  year={2025},
  volume={},
  number={},
  pages={78-88},
  abstract={Background: Software systems powered by large language models are becoming a routine part of everyday technologies, supporting applications across a wide range of domains. In software engineering, many studies have focused on how LLMs support tasks such as code generation, debugging, and documentation. However, there has been limited focus on how full systems that integrate LLMs are tested during development. Aims: This study explores how LLM-powered systems are tested in the context of real-world application development. Method: We conducted an exploratory case study using 99 individual reports written by students who built and deployed LLM-powered applications as part of a university course. Each report was independently analyzed using thematic analysis, supported by a structured coding process. Results: Testing strategies combined manual and automated methods to evaluate both system logic and model behavior. Common practices included exploratory testing, unit testing, and prompt iteration. Reported challenges included integration failures, unpredictable outputs, prompt sensitivity, hallucinations, and uncertainty about correctness. Conclusions: Testing LLM-powered systems required adaptations to traditional verification methods, blending source-level reasoning with behavior-aware evaluations. These findings provide evidence on the practical context of testing generative components in software systems.},
  keywords={Codes;Sensitivity;Uncertainty;Large language models;Manuals;System integration;Software systems;Cognition;Logic;Testing;LLMs;software testing;guidelines},
  doi={10.1109/SCAM67354.2025.00015},
  ISSN={2470-6892},
  month={Sep.}
}

@ARTICLE{11363193,
  author={Barathidass, Charles and Namburu, Karthik},
  journal={IEEE Access}, 
  title={Rapid End-to-End Test Generation and Hallucination Mitigation Using Generative Artificial Intelligence}, 
  year={2026},
  volume={14},
  number={},
  pages={20605-20619},
  abstract={End-to-end testing of distributed systems remains constrained by rapidly evolving architectures and maintenance requirements. Previous template-based solutions required months of engineering effort and lacked scalability owing to Document Object Model (DOM) selector fragility. This study proposes a novel single-shot testing methodology using abstract-class-based DOM referencing combined with operation-specific prompt templates for Create, Read, Update, and Delete workflows. In contrast to conventional chain-of-thought prompting, which requires multiple iterations, our approach eliminates complex reasoning chains while standardizing large language model outputs through structured abstraction layers. Empirical validation across 15 services generated over 900 test cases, reducing the manual effort from weeks to approximately 4 h per service while achieving 80%–90% accuracy. In addition, error analysis revealed typical distributions, with the most frequent failures being the selector mismatches and the absent assertions. The framework was implemented by a single engineer in one week, compared to the months required for template-based systems. This methodology advances automated quality assurance and test case generation by balancing abstraction and specificity for rapid baseline coverage in cloud-native environments. This verification shows the scalability of the methodology and the versatility of the approach in many enterprise situations, including the foundation of future benchmarking as well as adaptive abstraction methodologies.},
  keywords={Unified modeling language;Test pattern generators;Testing;Cognition;Manuals;Adaptation models;Accuracy;Prompt engineering;Natural language processing;Automation;Chain-of-thought prompting;end-to-end test automation;generative artificial intelligence;hallucination mitigation;large language model;prompt engineering;quality assurance;software testing;template-based test generation;test case generation},
  doi={10.1109/ACCESS.2026.3657407},
  ISSN={2169-3536},
  month={}
}


@INPROCEEDINGS{11259411,
  author={Long, Jianlin and Qin, Renchao and Jiang, Zujun and Duan, Jialin and Li, Suonan and Qu, Xiaosheng},
  booktitle={2025 18th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)}, 
  title={A Python Unit Test Generation Method Based on Fine-Tuned Language Models and Coverage}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Unit testing is fundamental for software reliability, yet manual test construction is inefficient and often results in limited coverage. Existing automated tools struggle with complex structures, while general-purpose large language models (LLMs) lack domain adaptability and fine-grained coverage control. To address this, we propose a domain adaptive finetuning approach based on the DeepSeek-R1-Distill-Qwen-7B (DeepSeek-7B) model. Using a high quality function-test dataset, the model is fine-tuned with structured prompts that encode abstract syntax tree (AST) execution paths, and a Coverage.py-based feedback mechanism iteratively fills uncovered regions to improve controllability. Experiments on seven open-source projects show substantial gains in line coverage, branch coverage, and mutation score, especially in Spark and Django. Compared with the base model, our method achieves over 20% higher coverage and outperforms Pynguin. Ablation studies confirm the combined effectiveness of structured prompts and coverage feedback, enabling up to 88.6% line coverage, 83.3% branch coverage, and a mutation score of 78.9%.},
  keywords={Adaptation models;Trees (botanical);Syntactics;Data models;Dynamic programming;Software reliability;Iterative methods;Test pattern generators;Sparks;Python;unit test;llMs;fine-tuning;coverage},
  doi={10.1109/CISP-BMEI68103.2025.11259411},
  ISSN={},
  month={Oct}
}

@INPROCEEDINGS{11273250,
  author={Hermawan, Rahmanu and Bucaioni, Alessio and Enoiu, Eduard and Afzal, Wasif},
  booktitle={2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion (MODELS-C)}, 
  title={Benchmarking Large Language Models for Root Cause Analysis in Train Control Software Testing}, 
  year={2025},
  volume={},
  number={},
  pages={648-657},
  abstract={Software quality assurance is critical in safety-critical domains like railway systems, where failures can have catastrophic consequences. In this context, train control and management systems play a central role, and their software must undergo rigorous validation. Alstom Rail Sweden AB employs a digital twin infrastructure to simulate and validate train control and management systems software. While this setup significantly improves system-level testing, the root cause analysis of test failures remains a manual and time-consuming bottleneck.This study explores the potential of large language models to automate root cause analysis by interpreting execution logs generated during digital twin-based testing. We benchmark seven state-of-the-art large language models, Aion-1.0, DeepSeek R1, DeepSeek V3 0324, Mistral Small 3.1 24B, GPT o3-mini, Gemini 2.5 Pro Experimental, and QwB 32B, using zero-shot chain-of-thought prompting to assess their ability to reason about fault patterns in real-world industrial test execution logs. The logs, sourced from Alstom’s digital twin-based testing environment, capture complex operational behaviour typical of embedded, safety-critical systems.Our results show that Gemini 2.5 Pro Experimental achieved the best performance with 66.7% accuracy and strong reasoning quality in this domain, contributing to the future research agenda to improve the accuracy prediction.},
  keywords={Software testing;Rails;Root cause analysis;Accuracy;Large language models;Software quality;Benchmark testing;Control systems;Rail transportation;System software;root cause analysis;log analysis;11m},
  doi={10.1109/MODELS-C68889.2025.00089},
  ISSN={},
  month={Oct}
}

@INPROCEEDINGS{11208370,
  author={Oțelea, Ionuț-Gabriel and Pintea, Bogdan and Rughiniș, Răzvan Victor and Tîrșu, Valentina},
  booktitle={2025 24th RoEduNet Conference: Networking in Education and Research (RoEduNet)}, 
  title={Evaluating LLMs for Automated Requirement and Test Case Generation in Railway Signaling Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) have shown potential in supporting requirements engineering through automation, especially in regulated and safety-critical domains. This paper evaluates the capabilities of 3 well-known LLMs (GPT-4, Claude, Gemini) in transforming user requirements into structured product requirements and corresponding test cases within the context of railway signaling. A custom dataset of client requirements, inspired by realistic signaling scenarios, was developed to enable consistent evaluation across models. Each model's outputs were assessed using defined metrics, including completeness, correctness, consistency, and traceability. The comparative results highlight variations in quality and structure of the generated artifacts, with specific strengths observed for different tasks. While all three models demonstrate promise, their reliability and consistency vary, and human oversight remains essential. This study provides practical insights into the applicability of current LLMs for augmenting early-stage requirements and verification workflows in critical systems engineering.},
  keywords={Solid modeling;Costs;Communication system signaling;Rail transportation;Safety;Requirements engineering;Security;Reliability;Prompt engineering;Modeling;LLM;Requirements Engineering;Automated Test Case Generation;Railway Signaling Systems;Safety-Critical Systems;NLP;Requirements Transformation},
  doi={10.1109/RoEduNet68395.2025.11208370},
  ISSN={2247-5443},
  month={Sep.}
}

@INPROCEEDINGS{11214929,
  author={Li, Qinting and Han, Zhonghai and Yang, Liangyi and Zhang, Qi and Xiong, Yue},
  booktitle={2025 8th International Conference on Transportation Information and Safety (ICTIS)}, 
  title={Automated Compliance Testing Case Generation for Intelligent Connected Vehicles: A Multi-Layer Knowledge-Augmented Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1679-1685},
  abstract={Intelligent connected vehicle (ICV) testing faces significant challenges due to growing complexity and the need to comply with multiple regulatory standards. Traditional manual template-based and single-standard approaches suffer from limited scenario coverage, compliance risks, and inefficiency. This paper introduces the Multi-Standard Collaborative Compliance Framework (MSCCF), which integrates cross-domain standards through dynamic regulatory knowledge graphs, dual-engine formal verification, compliance-guided generative models, and multidimensional test generation. Our framework combines retrieval-augmented generation (RAG) with rule-constrained reasoning to create compliance-guaranteed test cases, while enabling comprehensive scenario simulation through hierarchical task decomposition (HTD). Experimental validation demonstrates superior performance in compliance accuracy (F1-score: 0.94) and scenario coverage (89.7%) compared to baseline methods, establishing a scalable approach for multi-standard ICV testing across seven critical dimensions: road geometry, infrastructure status, dynamic objects, environmental conditions, digital communication, occupant states, and vehicle health.},
  keywords={Connected vehicles;Accuracy;Systematics;Scalability;Transportation;Knowledge graphs;Conformance testing;Test pattern generators;Vehicle dynamics;Standards;Intelligent connected vehicle (ICV);multi-standard compliance;test generation;dynamic regulatory knowledge graphs},
  doi={10.1109/ICTIS68762.2025.11214929},
  ISSN={2832-899X},
  month={July}
}

@ARTICLE{11506351,
  author={Ahmad, Azeem and Naeem, Muhammad Rashid},
  journal={IEEE Access}, 
  title={Boosting Test Generation in Industrial Codebases: A Comparative Study of Base and Fine-Tuned LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Large Language Models (LLMs) have demonstrated promising capabilities in automated software engineering tasks, particularly in test case generation. Recently, researchers and practitioners have actively explored using open-source datasets with both open-source and commercial LLMs for generating test cases from source code and related software artifacts. However, the effectiveness of (fine-tuned vs base) open-source LLMs in industrial settings remains under explored. This study investigates the performance of various fine-tuned and base configurations of the DeepSeek-Coder 33B model (i.e., base and instruct) for unit test generation in a large-scale industrial code-base. This study propose a two-loop refinement strategy: Loop 1 generates initial test cases, while Loop 2 refines failed cases based on compilation errors and code coverage feedback. Eight different LLM configurations were evaluated using compilation success rate and line coverage as performance metrics. Our findings reveal that fine-tuned models significantly outperform base models, and the proposed refinement strategy leads to measurable improvements in both test compilation and code coverage. The use of fine-tuned-instruct model in loop 1 and fine-tuned-instruct model in loop 2 yielded the highest line coverage (62.56%) and compilation success. This work demonstrates the value of domain-specific fine-tuning and multi-phase feedback strategies in enhancing LLM-powered software testing pipelines.},
  keywords={Feedback;Circuits;LoRa;Communication systems;Internet;Radio access networks;Regional area networks;Telecommunications;Computer networks;Radio communication},
  doi={10.1109/ACCESS.2026.3690571},
  ISSN={2169-3536},
  month={}
}

@INPROCEEDINGS{11499660,
  author={M, Carol Joanna Bright and P, Kripaa and S, Karishma and I, Freida Judith and Rahman, Usama Abdur},
  booktitle={2026 International Conference on Innovative Trends in Information Technology (ICITIIT)}, 
  title={Improving Software Testing with RAG-Based LLMs and Supporting Indian Regional Languages}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Automated generation of software test cases are one of the crucial tasks in modern software engineering, while the traditional method of manually writing test cases is time-consuming, prone to making errors and often fails to achieve contextual or linguistic accuracy. This paper proposes a Retrieval-Augmented Generation based method, which integrates dynamic knowledge retrieval with LLMs to generate highly faithful and contextually grounded test cases. Unlike general fine-tuned LLMs, which require extensive retraining, the proposed RAG pipeline uses lanceDB to store domain related knowledge and SentenceTransformers to semantically retrieve knowledge from the database, thus offering more reliability with much lower computational cost. Besides this, the suggested pipeline allows multilingual test case generation done by the LLM model across English and other Indian regional languages like Hindi, Tamil, Telugu, Malayalam and Kannada making software test more inclusive for language sensitive software ecosystems. The generated test cases are observed to be semantically aligned with the retrieved context and real-world user stories thus improving factual consistency and software reliability. Experimental evaluation shows consistent faithfulness scores, showing the effectiveness of the RAG pipeline and LLMs generation. Results confirm the embeddings quality, retrieval accuracy and reasoning capability within the model. Also, the architecture can be optionally extended for user feedback-based continual learning by integrating it with QA platforms such as Jira via Model Context Protocol (MCP) which gives the possibility to modify the model as per the project requirements. Overall, this study shows that RAG based models could provide scalable, multilingual and intelligent automation in future software quality assurance.},
  keywords={Feeds;Feedback;Circuits;Protocols;Communication systems;HTTP;Internet;Telecommunications;Videos;Computer networks;Retrieval Augmented Generation;Large Language Models;Software Test Case Generation;Multilingual NLP;Information Retrieval;Vector Database},
  doi={10.1109/ICITIIT68860.2026.11499660},
  ISSN={},
  month={March}
}

@INPROCEEDINGS{10771307,
  author={Su, Qingran and Li, Xingze and Ren, Yuming and Ouyang, Xulang and Hu, Chunming and Yin, Yongfeng},
  booktitle={2024 IEEE 35th International Symposium on Software Reliability Engineering Workshops (ISSREW)}, 
  title={State Diagram Extension and Test Case Generation Based on Large Language Models for Improving Test Engineers’ Efficiency in Safety Testing}, 
  year={2024},
  volume={},
  number={},
  pages={287-294},
  abstract={Safety testing is a key method to ensure software quality. But the quality of the test depends on the level of the test engineers. The method of generating safety test cases based on state diagrams often perform poorly due to lack of personnel experience. Meanwhile, the manual construction of test cases constrains the improvement of safety testing efficiency. This article utilizes LLMs to achieve automated extension and testing of safety state diagrams. The main contributions include extracting safety properties from aviation standards and extending the basic state diagram with LLMs to enable safety testing capabilities. In addition, a genetic algorithm combining edge first depth traversal and LLMs optimization was proposed to improve the efficiency of test case generation. Compared to classical genetic algorithms, the average execution round achieved a 90% reduction. Our LLMs optimization strategy can also enhance other improved genetic algorithms, further improving the efficiency of safety testing.},
  keywords={Large language models;Software quality;Manuals;Safety;Software reliability;Personnel;Optimization;Standards;Testing;Genetic algorithms;safety testing;LLMs;safety state diagrams;test case generation},
  doi={10.1109/ISSREW63542.2024.00092},
  ISSN={2994-810X},
  month={Oct}
}

@INPROCEEDINGS{10628480,
  author={Arora, Chetan and Herda, Tomas and Homm, Verena},
  booktitle={2024 IEEE 32nd International Requirements Engineering Conference (RE)}, 
  title={Generating Test Scenarios from NL Requirements Using Retrieval-Augmented LLMs: An Industrial Study}, 
  year={2024},
  volume={},
  number={},
  pages={240-251},
  abstract={Test scenarios are specific instances of test cases that describe a sequence of actions to validate a particular software functionality. By outlining the conditions under which the software operates and the expected outcomes, test scenarios ensure that the software functionality is tested in an integrated manner. Test scenarios are crucial for systematically testing an application under various conditions, including edge cases, to identify potential issues and guarantee overall performance and reliability. Manually specifying test scenarios is tedious and requires a deep understanding of software functionality and the underlying domain. It further demands substantial effort and investment from already time- and budget-constrained requirements engineers and testing teams. This paper presents an automated approach (RAGTAG) for test scenario generation using Retrieval-Augmented Generation (RAG) with Large Language Models (LLMs). RAG allows the integration of specific domain knowledge with LLMs' generation capabilities. We evaluate RAGTAG on two industrial projects from Austrian Post with bilingual requirements in German and English. Our results from an interview survey conducted with four experts on five dimensions – relevance, coverage, correctness, coherence and feasibility, affirm the potential of RAGTAG in automating test scenario generation. Specifically, our results indicate that, despite the difficult task of analyzing bilingual requirements, RAGTAG is able to produce scenarios that are well-aligned with the underlying requirements and provide coverage of different aspects of the intended functionality. The generated scenarios are easily understandable to experts and feasible for testing in the project environment. The overall correctness is deemed satisfactory; however, gaps in capturing exact action sequences and domain nuances remain, underscoring the need for domain expertise when applying LLMs.},
  keywords={Surveys;Large language models;Coherence;Software systems;Software reliability;Scenario generation;Requirements engineering;Requirements Engineering;Requirements-driven Testing;Test Scenarios;Large Language Models (LLMs);Industry Study},
  doi={10.1109/RE59067.2024.00031},
  ISSN={2332-6441},
  month={June}
}

@INPROCEEDINGS{10196883,
  author={Zhang, Yifan and Towey, Dave and Pike, Matthew},
  booktitle={2023 IEEE 47th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Automated Metamorphic-Relation Generation with ChatGPT: An Experience Report}, 
  year={2023},
  volume={},
  number={},
  pages={1780-1785},
  abstract={This paper reports on a pilot study of using ChatGPT, a language model based on GPT-3.5 architecture, for automatic generation of metamorphic relations (MRs), in the context of testing of autonomous driving systems (ADSs). The oracle problem is a major challenge in testing such systems, where it is difficult to determine whether or not the output of a system is correct. Metamorphic testing (MT) can alleviate this problem by checking the consistency of the system’s outputs under various transformations. However, manual generation of MRs is often a time-consuming and error-prone process. Automated MR generation can yield several benefits, including enhanced efficiency, quality, coverage, scalability, and reusability in software testing, thereby facilitating a more comprehensive and effective testing process. In this paper, we investigate the effectiveness of using ChatGPT for automatic generation of MRs for ADSs. We provide a detailed methodology for generating MRs using ChatGPT and evaluate the generated MRs using our domain knowledge and existing MRs. The results of our study indicate that our proposed approach is effective at generating high-quality MRs, and can significantly reduce the manual effort required for MR generation. Furthermore, we discuss the practical implications and limitations of using ChatGPT for MR generation and provide recommendations for future research. Our study contributes to the advancement of automated testing of ADSs, which is crucial for ensuring their safety and reliability in real-world scenarios.},
  keywords={Software testing;Scalability;Manuals;Computer architecture;Chatbots;Software;Safety;Autonomous driving system (ADS);metamorphic testing (MT);metamorphic relation (MR);oracle problem;ChatGPT;natural language processing (NLP);large language model (LLM)},
  doi={10.1109/COMPSAC57700.2023.00275},
  ISSN={0730-3157},
  month={June}
}

@INPROCEEDINGS{11395683,
  author={Hariharan, Mohanakrishnan},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Reinforcement Learning Integrated Agentic RAG for Software Test Cases Authoring}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper introduces a framework that integrates reinforcement learning (RL) with autonomous agents to enable continuous improvement in the automated process of software test cases authoring from business requirement documents within Quality Engineering (QE) workflows. Conventional systems employing Large Language Models (LLMs) generate test cases from static knowledge bases, which fundamentally limits their capacity to enhance performance over time. Our proposed Reinforcement Infused Agentic RAG (Retrieve, Augment, Generate) framework overcomes this limitation by employing AI agents that learn from QE feedback, assessments, and defect discovery outcomes to automatically improve their test case generation strategies. The system combines specialized agents with a hybrid vector-graph knowledge base that stores and retrieves software testing knowledge. Through advanced RL algorithms, specifically Proximal Policy Optimization (PPO) and Deep Q-Networks (DQN), these agents optimize their behavior based on QE-reported test effectiveness, defect detection rates, and workflow metrics. As QEs execute AI-generated test cases and provide feedback, the system learns from this expert guidance to improve future iterations. Experimental validation on enterprise Apple projects yielded substantive improvements: a 2.4% increase in test generation accuracy (from 94.8% to 97.2%), and a 10.8% improvement in defect detection rates. The framework establishes a continuous knowledge refinement loop driven by QE expertise, resulting in progressively superior test case quality that enhances, rather than replaces, human testing capabilities.},
  keywords={Software testing;Automation;Accuracy;Knowledge based systems;Software algorithms;Reinforcement learning;System software;Test pattern generators;Defect detection;Multi-agent systems;Reinforcement Learning;Agentic Systems;Software Testing;Retrieval-Augmented Generation;Multi-Agent Systems;Continuous Learning;RAG},
  doi={10.1109/ICAIC67076.2026.11395683},
  ISSN={},
  month={Feb}
}

@ARTICLE{11411685,
  author={Sisomboon, Wantana and Kaewyotha, Jakkrit and Songpan, Wararat},
  journal={IEEE Access}, 
  title={Automated Software Test Case Generation Using Directional Partially Weighted Ensemble Large Language Models With Retrieval-Augmented Generation (RAG)}, 
  year={2026},
  volume={14},
  number={},
  pages={31124-31145},
  abstract={Ensuring software quality relies on testing practices that can reliably confirm whether delivered systems meet user requirements. While Acceptance Test-Driven Development (ATDD) encourages early collaboration between stakeholders and developers, creating comprehensive acceptance test cases remains a human task that heavily depends on domain expertise. Recent progress in Large Language Models (LLMs) has made automated test case generation feasible. However, approaches based on a single model often suffer from performance instability, uneven test coverage, and a limited ability to generalize across heterogeneous requirements. This study proposes an automated test case generation framework that combines directional partially weighted ensemble large language models (LLMs) with Retrieval-Augmented Generation (RAG). The framework assigns model influence dynamically according to directional performance trends and degrees of partial correctness and consolidates candidate outputs through a weighted majority-voting mechanism and cross-validation conducted over multiple folds. Five state-of-the-art LLMs, Claude, ChatGPT, Gemini, Qwen, and Mistral, were evaluated using 16 criteria derived from four widely adopted closed box testing techniques: Boundary Value Analysis, Equivalence Partitioning, Use Case testing, and State Transition testing. Under the evaluated experimental conditions, the proposed framework achieved 98.44% test coverage, indicating complete consistency with the defined gold-standard acceptance criteria. Cross-validation results further demonstrate improved robustness, stronger generalization to previously unseen requirements, and linear scalability, supporting practical deployment in real-world software development environments, and complexity analysis to confirm linear throughout growth (O(n)), which supports efficient deployment under increasing workloads.},
  keywords={Testing;Retrieval augmented generation;Software testing;Large language models;Closed box;Test pattern generators;Collaboration;Chatbots;Stakeholders;Software reliability;LLM;RAG;weighted ensemble;directional partially;test coverage;ATDD;automated software testing},
  doi={10.1109/ACCESS.2026.3667925},
  ISSN={2169-3536},
  month={}
}

@ARTICLE{11422864,
  author={Trong, Mai Phu and Tung Son, Ngo and Hai, Le Ngoc and Giang, Vu Truong and Viet, Bui Hoang and Tung, Dinh Thanh},
  journal={IEEE Access}, 
  title={A Business Process-Centric Approach for LLM-Driven Functional Test Generation}, 
  year={2026},
  volume={14},
  number={},
  pages={44120-44146},
  abstract={Validating end-to-end business processes requires strict adherence to state logic, particularly for long-horizon workflows involving complex multi-role interactions. While Large Language Models (LLMs) offer promising automation capabilities, current approaches often lack integration with formal testing principles, leading to inherent “happy path bias” and difficulties in maintaining context across extended sessions. This paper proposes a hybrid, business process-centric methodology that addresses these limitations through a “separation of concerns” architecture. Our framework utilizes LLMs for semantic comprehension while rigorously enforcing Specification-Based Testing techniques-specifically Equivalence Partitioning, Boundary Value Analysis (BVA), and Pairwise Testing-to optimize data coverage. Furthermore, the methodology employs graph-based modeling for deterministic navigation and systematically synthesizes exception flows to ensure robustness for cross-functional user journeys. Crucially, the generated test artifacts are engineered for compliance with the ISO/IEC/IEEE 29119-3 standard, ensuring industrial interoperability. Empirical evaluation across multiple subject systems demonstrates high-fidelity performance, achieving significant Boundary Value Coverage (avg. >88%), superior State Transition Coverage (avg. >95%), and high semantic quality scores (>92%). Moreover, an economic feasibility analysis confirms the framework’s efficiency, with operational costs ranging from  ${\$}$ 1.41 to  ${\$}$ 1.82 per complete regression suite. These findings suggest that integrating LLMs as semantic engines within a framework grounded in established software testing techniques offers a robust and cost-effective path toward scalable test automation.},
  keywords={Testing;Business;Standards;Semantics;Software development management;Large language models;Automation;Translation;Test pattern generators;System testing;Large language models;software testing;test automation;functional testing},
  doi={10.1109/ACCESS.2026.3671629},
  ISSN={2169-3536},
  month={}
}

@INPROCEEDINGS{11144230,
  author={Xia, Min and Tong, Guang},
  booktitle={2025 10th International Conference on Electronic Technology and Information Science (ICETIS)}, 
  title={Application and Optimization of Retrieval-Augmented Generation in Automotive Software Test Case Generation}, 
  year={2025},
  volume={},
  number={},
  pages={469-474},
  abstract={This study proposes a Retrieval-Augmented Generation (RAG) based Test Case Generation Framework integrated with Multi-Strategy Routing, enabling intelligent adaptation from rapid prototyping to rigorous verification through a Three-Tier Strategy Network. A progressive three-level test case generation strategy system is introduced, consisting of Basic One-Time Generation (Strategy A), Comprehensive Requirement Coverage Verification (Strategy B), and Compatibility Incremental Enhancement (Strategy C). By constructing a Dynamic Strategy Routing Network, intelligent matching between requirement complexity and generation strategies is achieved. Experimental results demonstrate that the three strategies exhibit effective complementarity in key metrics such as requirement coverage rate ($93.7 \%$ vs. $62.3 \%$) and generation efficiency (33.2s vs. 55.6s), providing optimal solutions across different testing stages.},
  keywords={Measurement;Information science;Retrieval augmented generation;Routing;Rapid prototyping;Software;Vehicle dynamics;Optimization;Testing;Smart manufacturing;Retrieval-Augmented Generation (RAG);Smart Manufacturing;Automated Test Case Generation;Multi-Strategy Routing},
  doi={10.1109/ICETIS66286.2025.11144230},

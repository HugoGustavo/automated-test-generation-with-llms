@ARTICLE{11184836,
  author={Yang, Zhuoying and Wang, Lei},
  journal={IEEE Access}, 
  title={IntelliUnitGen: A Unit Test Case Generation Framework Based on the Integration of Static Analysis and Prompt Learning}, 
  year={2025},
  volume={13},
  number={},
  pages={177760-177784},
  abstract={Test case generation is a critical research topic in the field of automated software engineering. In recent years, with the rapid advancement of large language models (LLMs) such as the GPT series, LLaMA series, and DeepSeek series, both domestic and international researchers have attempted to leverage prompt learning capabilities of LLMs for automated test case generation and have achieved promising results. However, most existing approaches rely solely on the language model’s ability to respond to natural language prompts, while neglecting systematic analysis of static features within source code. These methods often fail to apply traditional static analysis techniques to extract structural and semantic information from the source code, resulting in incomplete generation, omission of key elements, or semantic misinterpretation. To address these limitations, this paper proposes IntelliUnitGen — an intelligent unit test case generation framework that integrates static analysis with prompt learning. This framework aims to combine the advantages of traditional static analysis techniques with the cutting-edge capabilities of LLMs to enhance the automation level and quality of unit test case generation. IntelliUnitGen synthesizes static code features extracted via static analysis into structured, task-relevant prompts for the language model. It adopts a chain-of-thought prompting strategy to guide the LLM in generating rigorous and comprehensive test cases. The overall workflow of the proposed framework is presented, followed by a detailed introduction to its key techniques and implementation details. An illustrative example is provided to intuitively demonstrate the test case generation process of the framework, and experimental validation is conducted on three open-source projects. Experimental results show that IntelliUnitGen significantly outperforms traditional (non-LLM-based) tools and LLM-only prompt learning approaches in metrics such as coverage, generalizability, and compilability & executability, achieving state-of-the-art (SOTA) performance. This study demonstrates the potential of integrating static code analysis with prompt learning to improve not only unit test case generation but also other source code processing tasks, potentially overcoming existing limitations of LLMs in software engineering applications. This framework demonstrates a practical step forward in addressing long-standing challenges in automated software testing. To facilitate reproducibility and further research, the complete implementation of the IntelliUnitGen framework, alongside the generated test cases and JaCoCo coverage reports for all experimental projects, has been made publicly available at: https://github.com/yangzy0115/IntelliUnitGen},
  keywords={Static analysis;Codes;Testing;Source coding;Semantics;Test pattern generators;Software engineering;Cognition;Analytical models;Logic;Software engineering;unit test case generation;prompt learning;static analysis;chain-of-thought prompting;source code processing;large language models;automated software engineering},
  doi={10.1109/ACCESS.2025.3615990},
  ISSN={2169-3536},
  month={}
}

@INPROCEEDINGS{11497649,
  author={Vijayamahantesh and A, Ashwitha and E, Naresh and Pareek, Piyush Kumar},
  booktitle={2026 International Conference on Next-Gen Quantum and Advanced Computing: Algorithms, Security, and Beyond (NQComp)}, 
  title={TestAgentX: Leveraging Large Language Models and Reinforcement Learning for Scalable and Adaptive Software Testing}, 
  year={2026},
  volume={},
  number={},
  pages={599-604},
  abstract={The goal of resilient software testing is to guarantee that software systems continue to work as intended in the face of failure, changes in their environment, or unexpected inputs. Software resilience under stress is evaluated using methods like adaptive test techniques, mutation testing, and chaos engineering to improve dependability in hostile or ever-changing environments. Automating and improving software quality assurance is the goal of this paper's agentic testing system, which makes use of artificial intelligence agents. To create context aware test cases, assess the effectiveness of patches, and discover regressions in real-time, the proposed approach blends reinforcement learning, fuzzy logic, knowledge graph reasoning, and large language models (LLMs). Agentic architecture allows for human-in-the-loop review for continual improvement and dynamically adapts to changing codebases, unlike conventional static testing techniques. To run a plethora of tests on the Defects4J dataset, which contains 835 actual Java errors. When contrasted with EvoSuite, the framework's results showed an 89% test coverage, an 84% mutation score, and a 55% reduction in test generation time. It also showed an 86% regression detection rate, a 91% accuracy rate for patch verification, and a very low false positive rate of only 8%. By a wide margin, fuzzy validation outperformed conventional methods, with an 82% developer acceptance rate and a contextual relevance score of 0.88. Notably, scores surpassing 75% were achieved in the areas of cross-project generalization, noisy tolerance, and idea drift adaptability. Positioned as a next generation solution for continuous integration pipelines in modern software engineering environments, the results underscore the framework's ability to deliver robust, explainable, and scalable testing automation.},
  keywords={Radio broadcasting;Frequency modulation;Feedback;Circuits;Location awareness;Radio access networks;Regional area networks;Protocols;Mobile communication;HTTP;resilient software testing;large language models;reinforcement learning;adaptive test strategy;defects4j dataset;fuzzy logic},
  doi={10.1109/NQComp68334.2026.11497649},

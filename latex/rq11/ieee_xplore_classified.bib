@INPROCEEDINGS{11173474,
  author={Wang, Zhiyao and Guo, Xiujing and Tsuchiya, Tatsuhiro},
  booktitle={2025 25th International Conference on Software Quality, Reliability and Security (QRS)}, 
  title={Retrieval-Augmented Generation for Software Requirement-Based Test Case Generation}, 
  year={2025},
  volume={},
  number={},
  pages={108-119},
  abstract={Testers often need to manually write black-box test cases based on software artifacts such as requirement documents. In agile development, this process is often time-consuming and is further complicated by frequent requirement changes, leading to continuous maintenance overhead. Automating this process is therefore essential. Given the strong natural language understanding and generation capabilities of large language models (LLMs), combined with Retrieval-Augmented Generation (RAG), we propose a RAG-based framework for automated test case generation. Before generation, we embed software artifacts to construct a vectorbased knowledge database. At runtime, software requirements are used as queries to retrieve relevant context, which is integrated into a prompt and passed to the LLM for test case generation. This approach addresses several shortcomings of LLMs, including limited context length, attention dilution over large inputs, and the tendency to hallucinate or over-look key domain-specific constraints. By providing query-specific external knowledge, RAG enhances both accuracy and efficiency. We deploy the framework with different models locally and conduct experiments on two open-source datasets. Compared with the manually written benchmark test cases, our method achieves full requirement coverage with fewer test cases, improved efficiency, reduced error potential, and realized better readability.},
  keywords={Runtime;Databases;Large language models;Retrieval augmented generation;Closed box;Software quality;Natural language processing;Software reliability;Maintenance;Security;Test Case Generation;Retrieval-Augmented Generation;Large Language Model;Software Requirement},
  doi={10.1109/QRS65678.2025.00022},
  ISSN={2693-9177},
  month={July}
}

@INPROCEEDINGS{10554852,
  author={Xue, Zhiyi and Li, Liangguo and Tian, Senyue and Chen, Xiaohong and Chen, Liangyu and Zhang, Min and Li, Pingping and Jiang, Tingting},
  booktitle={2024 IEEE/ACM 46th International Conference on Software Engineering: Companion Proceedings (ICSE-Companion)}, 
  title={Domain Knowledge is All You Need: A Field Deployment of LLM-Powered Test Case Generation in FinTech Domain}, 
  year={2024},
  volume={},
  number={},
  pages={314-315},
  abstract={Despite the promise of automation, general-purpose Large Language Models (LLMs) face difficulties in generating complete and accurate test cases from informal software requirements, primarily due to challenges in interpreting unstructured text and producing diverse, relevant scenarios. This paper argues that incorporating domain knowledge significantly improves LLM performance in test case generation. We report on the successful deployment of our LLM-powered tool, LLM4Fin, in the FinTech domain, showcasing the crucial role of domain knowledge in addressing the aforementioned challenges. We demonstrate two methods for integrating domain knowledge: implicit incorporation through model fine-tuning, and explicit incorporation with algorithm design. This combined approach delivers remarkable results, achieving up to 98.18% improvement in test scenario coverage and reducing generation time from 20 minutes to 7 seconds.},
  keywords={Knowledge engineering;Automation;Accuracy;Software algorithms;Software;Faces;Software engineering;Large Language Models;Software Requirements;Test Case Generation;Natural Language},
  doi={10.1145/3639478.3643087},
  ISSN={2574-1934},
  month={April}
}

@INPROCEEDINGS{11290782,
  author={Ananda Ratmayanti, Putu Vidya and Sulistiyo Kusumo, Dana and Riskiana, Rosa Reska},
  booktitle={2025 3rd International Conference on Software Engineering and Information Technology (ICoSEIT)}, 
  title={Improving Requirement Comprehension in GPT Models for Enhanced Consistency in Test Case Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Test case generation is an essential component in the software testing lifecycle. Despite its importance, generating test cases automatically using Large Language Models such as GPT remains a challenging task. One of the most persistent issues observed is the inconsistency of generated outputs in terms of format, structure, and quantity, even when the input requirements are highly similar. Such inconsistencies reduce reliability, increase the need for human intervention, and limit the applicability of LLMs in real-world Quality Assurance practices. To address this limitation, this paper introduces a method aimed at enhancing the consistency of generated test cases by improving the model’s comprehension of requirements through a continual domain-adaptive pretraining approach. In this method, the GPT model is continually trained on functional requirements collected from a hospital management system, which are preprocessed using Natural Language Processing techniques to minimize ambiguity, normalize linguistic variations, and capture domain-specific patterns that reinforce contextual understanding. The performance of the pretrained model is then systematically compared with the baseline ChatGPT model using three evaluation metrics. Experimental results demonstrate that the proposed model achieves 100% requirement coverage, records a significantly higher Jaccard similarity score of 0.78, and consistently generates executable test cases with a stable structure that aligns with best practices in software testing. These findings highlight the effectiveness of continual pretraining in improving requirement comprehension, reducing variability in generated outputs, and ultimately contributing to the development of more reliable, consistent, and scalable automated software testing workflows.},
  keywords={Software testing;Runtime;Hospitals;Large language models;Software quality;Reliability engineering;Software reliability;Selenium;Information systems;Context modeling;test case generation;continual pretraining;NLP;jaccard similarity;hospital information system;software testing automation;selenium testing},
  doi={10.1109/ICoSEIT67010.2025.11290782},
  ISSN={},
  month={Oct}
}

@INPROCEEDINGS{11322450,
  author={Talaat, Mohamed Gamal and Hassan, Mostafa and Sayed, Mohamed and Mohamed, Mohanad and Ahmed, Islam},
  booktitle={2025 37th International Conference on Microelectronics (ICM)}, 
  title={GrammLLM: Grammar-Guided LLM Test Generation for Compiler Validation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={We present a method for generating comprehensive test cases of a specific language-construct by leveraging grammar rules defined in a Language Reference Manual (LRM). The approach begins by analyzing Backus-Naur Form (BNF) grammar representation, then constructing a graphical traversal that captures all relevant paths for the targeted feature. This graph-based model illustrates every node and transitional path governed by the feature's grammar rules, enabling a clear visualization of feature behaviour and potential edge cases. We then employ a Large Language Model (LLM) to automatically propose scenarios that exhaustively cover these paths. Finally, these scenarios are passed through another Large Language Model (LLM) to implement these scenarios. Our method ensures thorough coverage and highlights corner cases that can be overlooked by traditional testing approaches. The resulting flow not only streamlines the testing and validation process for programming language features but also provides a flexible framework for verifying new or evolving functionalities.},
  keywords={Visualization;Large language models;Semantics;Manuals;Syntactics;Fuzzing;Grammar;Microelectronics;Test pattern generators;Testing;Grammar-based testing;Language Reference Manual;Compiler validation;Large Language Models;Test generation},
  doi={10.1109/ICM66518.2025.11322450},
